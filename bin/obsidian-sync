#!/usr/bin/env bash
# POSIX shell wrapper for obsidian-sync CLI companion
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/obsidian-sync.ps1" "$@"
elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/obsidian-sync.ps1" "$@"
else
    echo "[obsidian-sync] Error: Neither 'pwsh' nor 'powershell' was found on PATH." >&2
    exit 1
fi
